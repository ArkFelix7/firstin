[Unit]
Description=FirstIn agent API (FastAPI, uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=firstin
Group=firstin
WorkingDirectory=/opt/firstin
# Server-only settings (access code, public URL, CORS). /opt/firstin/.env (API keys) is read by the app itself.
EnvironmentFile=/etc/firstin/firstin.env
# ONE worker on purpose: runs, SSE streams and approval interrupts live in process memory.
ExecStart=/opt/firstin/agent/.venv/bin/python -m uvicorn agent.main:app --host 127.0.0.1 --port 8100 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --timeout-graceful-shutdown 5
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
