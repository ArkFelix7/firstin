# /etc/firstin/firstin.env  (server only; push.sh never overwrites it). chmod 640 root:firstin.
# API keys stay in /opt/firstin/.env (pushed from your laptop).

# --- backend (agent/) ---
# Shared access code for the whole hosted API. Unset/empty = no auth (local behaviour).
FIRSTIN_ACCESS_CODE=change-me
# Public origin of the API, used for absolute audio_url/pdf_url/html_url in /incab/active.
FIRSTIN_PUBLIC_API_URL=https://2.25.149.18.sslip.io
# Dashboard origin(s) on Vercel, comma-separated (adds to the localhost defaults).
FIRSTIN_CORS_ORIGINS=https://firstin.vercel.app
# Photon bridge on the same box (default http://localhost:8010). Set to "off" to disable texts.
PHOTON_URL=http://127.0.0.1:8010
# Optional neural TTS (setup_server.sh downloads this voice when piper installs)
PIPER_MODEL=/opt/piper/voices/en_US-lessac-medium.onnx

# --- photon/ bridge ---
# Same value as FIRSTIN_ACCESS_CODE (sent as Authorization: Bearer).
BACKEND_ACCESS_CODE=change-me
BACKEND_URL=http://127.0.0.1:8100
PHOTON_HOST=127.0.0.1
PHOTON_PORT=8010
# Review links in approval texts: <DASHBOARD_URL>/plan/<run_id>
DASHBOARD_URL=https://firstin.vercel.app
