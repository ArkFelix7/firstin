# --- FirstIn Photon (iMessage) bridge ---
# Mode: v2 (Photon 2.0 Beta, app.beta.photon.codes; default when the project id starts with pho_prj_)
#     | cloud (Spectrum Cloud v1, app.photon.codes) | local (this Mac's Messages app) | dry-run
PHOTON_MODE=v2
# Beta dashboard -> Settings (project id) and API keys (project:read + project:write)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_ORG_ID=
# Legacy names, still read if the PHOTON_* ones are empty:
# SPECTRUM_PROJECT_ID=
# SPECTRUM_PROJECT_SECRET=
# Officer's iPhone number in E.164 (comma-separate multiple). Only these senders may APPROVE/REJECT.
OFFICER_PHONE=+15555550123
# Where the FastAPI agent lives
BACKEND_URL=http://localhost:8000
# Port this bridge listens on (backend POSTs /notify here)
PHOTON_PORT=8010
# Optional: dashboard link included in the approval text
DASHBOARD_URL=http://localhost:3000
# Optional: name of the apparatus shown in messages
UNIT_NAME=Engine 12
# Hosted mode: same value as the backend's FIRSTIN_ACCESS_CODE (sent as Authorization: Bearer)
BACKEND_ACCESS_CODE=
# Hosted mode: bind address (127.0.0.1 keeps the bridge private; unset = all interfaces)
PHOTON_HOST=
